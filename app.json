{
  "expo": {
    "name": "Pro Scanner",
    "slug": "pro-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proscanner.app"
    },
    "android": {
      "package": "com.proscanner.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-file-system",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Prologo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/Prologo.png",
            "backgroundColor": "#0F0F11"
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "1d1bccc0-bae4-4967-8b4a-b5ab73dfdf12"
      }
    },
    "owner": "aakashsrnvsn",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1d1bccc0-bae4-4967-8b4a-b5ab73dfdf12"
    }
  }
}
